# ─────────────────────────────────────────────────────────────────────────────
# JARVIS — Environment Variables Template
#
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
# URL where your local Ollama server is running.
# Default is fine if Ollama is on the same machine.
OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model to use.
# Recommended: llama3.1:8b (capable, supports tool calling)
# Alternative:  phi3:mini  (smaller, faster, less capable)
# Pull first:   ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Optional: separate model for v0.3 multi-step planning (defaults to main model).
PLANNER_MODEL=qwen2.5:7b

# Maximum tokens the LLM may generate per response.
MAX_TOKENS=2048

# ── Storage ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to where you run `jarvis`).
DB_PATH=jarvis.db

# Local ChromaDB path for long-term / RAG memory (v0.2).
VECTOR_DB_PATH=./jarvis_data/chroma_db

# ── Context & Memory Management ──────────────────────────────────────
# LLM-facing conversation window (messages). Older turns are compacted into a
# rolling summary and the session's original task is re-anchored automatically.
MAX_CONTEXT_MESSAGES=24
# Hard per-message cap (characters) for tool results in the prompt; head and
# tail are kept with an explicit omission marker between them.
MAX_TOOL_OUTPUT_CHARS=6000

# ── Voice (v0.4) ──────────────────────────────────────────────────────────────
WHISPER_MODEL=base
TTS_VOICE=en-US-GuyNeural
VOICE_RECORD_SECONDS=5

# ── Tools ─────────────────────────────────────────────────────────────────────
# The read_file tool is sandboxed: it can only read files inside this directory.
# Use an absolute path for clarity, or "." for the current working directory.
FILE_READER_ALLOWED_DIR=.

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Code execution sandbox (v0.10) ──────────────────────────────────────
# Code execution stays OFF unless BOTH hold:
#   1. ENABLE_CODE_EXECUTION=true, and
#   2. Docker is actually usable (CLI + daemon + image pulled locally).
# When disabled, the tool is ABSENT from the LLM's tool surface entirely.
ENABLE_CODE_EXECUTION=false
# Container image for the sandbox. Prefer a digest pin for production,
# e.g. ubuntu:24.04@sha256:<digest>. The image must be pulled in advance
# (the sandbox never pulls images at runtime).
SANDBOX_IMAGE=ubuntu:24.04

# ── API authentication (v0.10) ──────────────────────────────────────
# Set a key to require `Authorization: Bearer <key>` (or X-API-Key) on all
# API endpoints except /health and OpenAPI docs. Leave empty for local-only
# trust (default). Use a long random value.
JARVIS_API_KEY=

# ── API rate limiting (v0.11, in-process) ──────────────────────
# Sliding window per client (API key when auth is on, else client IP).
# 0 disables. /health is exempt. For multi-replica deployments enforce
# limits at the reverse proxy instead.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Dashboard → API client (v0.11) ───────────────────────────
# Point the Streamlit dashboard at a running API server (it becomes a pure
# client and can run on another machine). Leave empty to use the legacy
# in-process runtime on the same machine.
JARVIS_API_URL=
# Key the dashboard sends (same value the server enforces).
JARVIS_CLIENT_API_KEY=
